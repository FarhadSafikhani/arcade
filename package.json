{
  "name": "arcade",
  "version": "1.0.0",
  "description": "A collection of classic arcade games built with PixiJS",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:snapforge && vite build",
    "build:prod": "npm run validate:snapforge && vite build --mode production",
    "preview": "vite preview",
    "serve": "vite preview",
    "increment-version": "node scripts/increment-version.js",
    "deploy": "node scripts/deploy.mjs",
    "clean": "rimraf dist",
    "build:clean": "npm run clean && npm run build:prod",
    "validate:snapforge": "node scripts/validate-snapforge.mjs",
    "test:snapforge": "node --test scripts/test-snapforge.mjs scripts/test-snapforge-compiler.mjs",
    "test:snapforge:scene": "node --test scripts/test-snapforge-scene.mjs scripts/test-snapforge-overlay.mjs scripts/test-snapforge-gallery.mjs",
    "test:stickers": "node --test scripts/test-stickers.mjs",
    "compile:snapforge": "node scripts/compile-snapforge.mjs",
    "prepare:snapforge-audio": "node scripts/prepare-snapforge-audio.mjs",
    "check:snapforge-recipes": "node scripts/check-snapforge-recipes.mjs"
  },
  "keywords": [
    "arcade",
    "games",
    "pixijs",
    "typescript",
    "snake",
    "breakout",
    "memory"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.186.0",
    "ffmpeg-static": "^5.3.0",
    "gh-pages": "^6.3.0",
    "rimraf": "^5.0.10",
    "rollup-plugin-obfuscator": "^1.1.0",
    "terser": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "pixi.js": "^7.3.0",
    "three": "^0.186.1"
  }
}
